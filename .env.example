# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/shop"

# Authentication (JWT - حداقل ۳۲ کاراکتر تصادفی)
JWT_SECRET="change-this-to-a-long-random-secret-key"

# App Base URL (بدون اسلش در انتها)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payment Gateway (اختیاری - در صورت استفاده از زرین‌پال)
ZARINPAL_MERCHANT_ID=""

# SMS.ir OTP (در صورت خالی بودن، کد OTP در ترمینال لاگ می‌شود)
SMS_IR_API_KEY=""
SMS_IR_TEMPLATE_ID=""