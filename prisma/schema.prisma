generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  //directUrl = env("DIRECT_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  username  String    @unique // تغییر ایمیل به نام کاربری اجباری
  password  String    // رمز عبور اجباری
  phone     String    @unique // شماره موبایل اجباری و یکتا
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  addresses Address[]
  orders    Order[]

  // 👇 ایندکس برای جستجوی سریع در پنل ادمین بر اساس نقش
  @@index([role])
}

// جدول موقت برای نگهداری کدهای تایید ارسال شده
model OtpRequest {
  id        String   @id @default(cuid())
  phone     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// جدول نگهداری تنظیمات کلی فروشگاه (برای روشن/خاموش کردن OTP)
model SystemSetting {
  key   String @id // مثال: "OTP_ENABLED"
  value String // مثال: "true" یا "false"
}

model Address {
  id          String  @id @default(cuid())
  title       String
  fullName    String
  phone       String
  province    String
  city        String
  addressLine String
  postalCode  String
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[] // همچنان رابطه با سفارشات برقرار است
}

model Category {
  id            String     @id @default(cuid())
  name          String
  slug          String     @unique
  parentId      String?    // 👈 فیلد اختیاری شناسه دسته‌بندی مادر
  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subcategories Category[] @relation("CategoryHierarchy")
  products      Product[]

  // 👇 ایندکس برای لود سریع‌تر مگامنو و زیردسته‌ها
  @@index([parentId])
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  
  products  Product[] // ارتباط با محصولات

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  name       String      // مثال: "رنگ مشکی - سایز XL" یا "گارانتی ۱۸ ماهه"
  sku        String?     @unique // کد اختصاصی این تنوع برای انبارداری
  
  price      Decimal?    @db.Decimal(12, 0) // قیمت اختصاصی (اگر خالی بود، قیمت اصلی محصول لحاظ می‌شود)
  stock      Int         @default(0) // موجودی مستقل این تنوع
  
  colorCode  String?     // (اختیاری) کد رنگ مثل "#000000" برای نمایش دایره رنگی در سایت
  
  orderItems OrderItem[]
}

model Product {
  id            String           @id @default(cuid())
  title         String
  slug          String           @unique
  brandId       String?
  brand         Brand?           @relation(fields: [brandId], references: [id])
  sku           String?          @unique
  description   String

  price         Decimal          @db.Decimal(12, 0)
  offerPrice    Decimal?         @db.Decimal(12,0)
  offerStartsAt DateTime?
  offerEndsAt   DateTime?
  
  variants      ProductVariant[]

  stock         Int              @default(0)
  categoryId    String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  featured      Boolean          @default(false)
  isActive      Boolean          @default(true)
  orderItems    OrderItem[]
  category      Category         @relation(fields: [categoryId], references: [id])
  images        ProductImage[]

  // 👇 ایندکس‌های ترکیبی برای سرعت بخشیدن به فیلترها و مرتب‌سازی در فروشگاه
  @@index([categoryId])
  @@index([brandId])
  @@index([isActive, createdAt(sort: Desc)])
}

model ShippingMethod {
  id            String   @id @default(cuid())
  name          String   // نام روش ارسال (مثال: پست پیشتاز، پیک موتوری)
  price         Decimal  @db.Decimal(12, 2) // هزینه ارسال
  estimatedTime String   // زمان تقریبی تحویل (مثال: ۲ تا ۴ روز کاری)
  isActive      Boolean  @default(true) // فعال یا غیرفعال بودن
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]
}

model PaymentMethod {
  id          String   @id @default(cuid())
  name        String   // نام روش (مثال: پرداخت آنلاین، کارت به کارت، پرداخت در محل)
  code        String   @unique // کد کلیدی سیستم (ONLINE, COD, CARD)
  description String?  // توضیحات راهنما برای خریدار
  isActive    Boolean  @default(true)
  merchantId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  order     Int?
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id                  String         @id @default(cuid())
  userId              String
  totalPrice          Decimal        @db.Decimal(12, 2)
  status              OrderStatus    @default(PENDING)

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  addressId           String?
  authority           String?
  refId               String?
  paidAt              DateTime?

  address             Address?       @relation(fields: [addressId], references: [id], onDelete: SetNull)
  user                User           @relation(fields: [userId], references: [id])

  shippingTitle       String
  shippingFullName    String
  shippingPhone       String
  shippingProvince    String
  shippingCity        String
  shippingAddressLine String
  shippingPostalCode  String

  items               OrderItem[]

  shippingMethodId    String?
  shippingMethod      ShippingMethod? @relation(fields: [shippingMethodId], references: [id])
  shippingCost        Decimal?        @db.Decimal(12, 2)
  paymentMethodId     String?
  paymentMethod       PaymentMethod?  @relation(fields: [paymentMethodId], references: [id])

  // 👇 ایندکس‌های حیاتی برای سرعت پروفایل مشتریان و داشبورد ادمین
  @@index([userId])
  @@index([status, createdAt(sort: Desc)])
  @@index([authority])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  productId String
  
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  quantity  Int
  price     Decimal         @db.Decimal(12, 2)
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
}

enum Role {
  USER
  ADMIN
  SUPPORT
  CONTENT_MANAGER
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}