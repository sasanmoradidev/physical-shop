# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Dynamic admin uploads (keep static banners & default logo in git)
/public/uploads/products/*
!/public/uploads/products/.gitkeep
/public/uploads/logo-*.png
/public/uploads/logo-*.jpg
/public/uploads/logo-*.webp

# Private uploaded payment receipts
/private-uploads/